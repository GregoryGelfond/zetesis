blocked(X) :- val(X,V), V \ 13 == 0, V > 0.
reach(n0).
reach(C) :- reach(P), edge(C,P), not blocked(C).
far(X) :- node(X), not reach(X).
up(X) :- far(X).
up(P) :- up(C), edge(C,P), not reach(P).
#show reach/1. #show up/1.
