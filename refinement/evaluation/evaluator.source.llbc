ull,"diagnostic_item":null},"generics":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":0}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[{"regions":[],"skip_binder":[{"Deduplicated":24},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[55,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":52},"Mut"]}]}],"output":{"Value":[56,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":54},"Mut"]}]}},"src":"Normal","body":"Opaque"},{"def_id":2,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["array",0]},{"Ident":["repeat",0]}],"span":{"Untagged":{"data":{"file_id":1,"beg":{"line":54,"col":0},"end":{"line":54,"col":57}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an array of type `[T; N]` by repeatedly cloning a value."},{"DocComment":""},{"DocComment":" This is the same as `[val; N]`, but it also works for types that do not"},{"DocComment":" implement [`Copy`]."},{"DocComment":""},{"DocComment":" The provided value will be used as an element of the resulting array and"},{"DocComment":" will be cloned N - 1 times to fill up the rest. If N is zero, the value"},{"DocComment":" will be dropped."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" Creating multiple copies of a `String`:"},{"DocComment":" ```rust"},{"DocComment":" use std::array;"},{"DocComment":""},{"DocComment":" let string = \"Hello there!\".to_string();"},{"DocComment":" let strings = array::repeat(string);"},{"DocComment":" assert_eq!(strings, [\"Hello there!\", \"Hello there!\"]);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Invar