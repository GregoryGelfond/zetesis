ositional":true,"ty":{"Deduplicated":0}},{"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":17,"col":19},"end":{"line":17,"col":24}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"_1","is_positional":true,"ty":{"Deduplicated":0}}],"discriminant":{"Signed":["Isize","4"]}}]},"layout":[{"key":"aarch64-apple-darwin","value":{"size":{"guarantee":null,"chosen":24},"align":{"guarantee":null,"chosen":8},"discriminator":{"Branch":{"offset":{"guarantee":null,"chosen":0},"int_ty":{"Unsigned":"U64"},"children":[[{"start":{"Unsigned":["U64","0"]},"end":{"Unsigned":["U64","0"]}},{"Known":0}],[{"start":{"Unsigned":["U64","1"]},"end":{"Unsigned":["U64","1"]}},{"Known":1}],[{"start":{"Unsigned":["U64","2"]},"end":{"Unsigned":["U64","2"]}},{"Known":2}],[{"start":{"Unsigned":["U64","3"]},"end":{"Unsigned":["U64","3"]}},{"Known":3}],[{"start":{"Unsigned":["U64","4"]},"end":{"Unsigned":["U64","4"]}},{"Known":4}]],"fallback":"Invalid"}},"uninhabited":false,"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":8}],"uninhabited":false,"tagger":[[0,{"Unsigned":["U64","0"]}]]},{"field_offsets":[],"uninhabited":false,"tagger":[[0,{"Unsigned":["U64","1"]}]]},{"field_offsets":[{"guarantee":null,"chosen":8},{"guarantee":null,"chosen":16}],"uninhabited":false,"tagger":[[0,{"Unsigned":["U64","2"]}]]},{"field_offsets":[{"guarantee":null,"chosen":8},{"guarantee":null,"chosen":16}],"uninhabited":false,"tagger":[[0,{"Unsigned":["U64","3"]}]]},{"field_offsets":[{"guarantee":null,"chosen":8},{"guarantee":null,"chosen":16}],"uninhabited":false,"tagger":[[0,{"Unsigned":["U64","4"]}]]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"},{"def_id":13,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["control_flow",0]},{"Ident":["ControlFlow",0]}],"span":{"Untagged":{"data":{"file_id":22,"beg":{"line":89,"col":0},"end":{"line":89,"col":31}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used to tell an operation whether it should exit early or go on as usual."},{"DocComment":""},{"DocComment":" This is used when exposing things (like graph traversals or visitors) where"},{"DocComment":" you want the user to be able to choose whether to exit early."},{"DocComment":" Having the enum makes it clearer -- no more wondering \"wait, what did `false`"},{"DocComment":" mean again?\" -- and allows including a value."},{"DocComment":""},{"DocComment":" Similar to [`Option`] and [`Result`], this enum can be used with the `?` operator"},{"DocComment":" to return immediately if the [`Break`] variant is present or otherwise continue normally"},{"DocComment":" with the value inside the [`Continue`] variant."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Early-exiting from [`Iterator::try_for_each`]:"},{"DocComment":" ```"},{"DocComment":" use std::ops::ControlFlow;"},{"DocComment":""},{"DocComment":" let r = (2..100).try_for_each(|x| {"},{"DocComment":"     if 403 % x == 0 {"},{"DocComment":"         return ControlFlow::Break(x)"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     ControlFlow::Continue(())"},{"DocComment":" });"},{"DocComment":" assert_eq!(r, ControlFlow::Break(13));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A basic tree traversal:"},{"DocComment":" ```"},{"DocComment":" use std::ops::ControlFlow;"},{"DocComment":""},{"DocComment":" pub struct TreeNode<T> {"},{"DocComment":"     value: T,"},{"DocComment":"     left: Option<Box<TreeNode<T>>>,"},{"DocComment":"     right: Option<Box<TreeNode<T>>>,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<T> TreeNode<T> {"},{"DocComment":"     pub fn traverse_inorder<B>(&self, f: &mut impl FnMut(&T) -> ControlFlow<B>) -> ControlFlow<B> {"},{"DocComment":"         if let Some(left) = &self.left {"},{"DocComment":"             left.traverse_inorder(f)?;"},{"DocComment":"         }"},{"DocComment":"         f(&self.value)?;"},{"DocComment":"         if let Some(right) = &self.right {"},{"DocComment":"             right.traverse_inorder(f)?;"},{"DocComment":"         }"},{"DocComment":"         ControlFlow::Continue(())"},{"DocComment":"     }"},{"DocComment":"     fn leaf(value: T) -> Option<Box<TreeNode<T>>> {"},{"DocComment":"         Some(Box::new(Self { value, left: None, right: None }))"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let node = TreeNode {"},{"DocComment":"     value: 0,"},{"DocComment":"     left: TreeNode::leaf(1),"},{"DocComment":"     right: Some(Box::new(TreeNode {"},{"DocComment":"         value: -1,"},{"DocComment":"         left: TreeNode::leaf(5),"},{"DocComment":"         right: TreeNode::leaf(2),"},{"DocComment":"     }))"},{"DocComment":" };"},{"DocComment":" let mut sum = 0;"},{"DocComment":""},{"DocComment":" let res = node.traverse_inorder(&mut |val| {"},{"DocComment":"     if *val < 0 {"},{"DocComment":"         ControlFlow::Break(*val)"},{"DocComment":"     } else {"},{"DocComment":"         sum += *val;"},{"DocComment":"         ControlFlow::Continue(())"},{"DocComment":"     }"},{"DocComment":" });"},{"DocComment":" assert_eq!(res, ControlFlow::Break(-1));"},{"DocComment":" assert_eq!(sum, 6);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`Break`]: ControlFlow::Break"},{"DocComment":" [`Continue`]: ControlFlow::Continue"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"ControlFlow"},"generics":{"regions":[],"types":[{"index":0,"name":"B","variance":"Covariant"},{"index":1,"name":"C","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Enum":[{"id":0,"span":{"Untagged":{"data":{"file_id":22,"beg":{"line":93,"col":4},"end":{"line":93,"col":12}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" Move on to the next phase of the operation as normal."}],"inline":null,"rename":null,"public":true},"name":"Continue","fields":[{"span":{"Untagged":{"data":{"file_id":22,"beg":{"line":93,"col":13},"end":{"line":93,"col":14}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"_0","is_positional":true,"ty":{"Deduplicated":22}}],"discriminant":{"Signed":["Isize","0"]}},{"id":1,"span":{"Untagged":{"data":{"file_id":22,"beg":{"line":97,"col":4},"end":{"line":97,"col":9}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" Exit the operation without running subsequent phases."}],"inline":null,"rename":null,"public":true},"name":"Break","fields":[{"span":{"Untagged":{"data":{"file_id":22,"beg":{"line":97,"col":10},"end":{"line":97,"col":11}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"_0","is_positional":true,"ty":{"Deduplicated":14}}],"discriminant":{"Signed":["Isize","1"]}}]},"layout":[],"ptr_metadata":"None"},{"def_id":14,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["Infallible",0]}],"span":{"Untagged":{"data":{"file_id":23,"beg":{"line":933,"col":0},"end":{"line":933,"col":19}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The error type for errors that can never happen."},{"DocComment":""},{"DocComment":" Since this enum has no variant, a value of this type can never actually exist."},{"DocComment":" This can be useful for generic APIs that use [`Result`] and parameterize the error type,"},{"DocComment":" to indicate that the result is always [`Ok`]."},{"DocComment":""},{"DocComment":" For example, the [`TryFrom`] trait (conversion that returns a [`Result`])"},{"DocComment":" has a blanket implementation for all types where a reverse [`Into`] implementation exists."},{"DocComment":""},{"DocComment":" ```ignore (illustrates std code, duplicating the impl in a doctest would be an error)"},{"DocComment":" impl<T, U> TryFrom<U> for T where U: Into<T> {"},{"DocComment":"     type Error = Infallible;"},{"DocComment":""},{"DocComment":"     fn try_from(value: U) -> Result<Self, Infallible> {"},{"DocComment":"         Ok(U::into(value))  // Never returns `Err`"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Future compatibility"},{"DocComment":""},{"DocComment":" This enum has the same role as [the `!` \u201cnever\u201d type][never],"},{"DocComment":" which is unstable in this version of Rust."},{"DocComment":" When `!` is stabilized, we plan to make `Infallible` a type alias to it:"},{"DocComment":""},{"DocComment":" ```ignore (illustrates future std change)"},{"DocComment":" pub type Infallible = !;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" \u2026 and eventually deprecate `Infallible`."},{"DocComment":""},{"DocComment":" However there is one case where `!` syntax can be used"},{"DocComment":" before `!` is stabilized as a full-fledged type: in the position of a function\u2019s return type."},{"DocComment":" Specifically, it is possible to have implementations for two different function pointer types:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" trait MyTrait {}"},{"DocComment":" impl MyTrait for fn() -> ! {}"},{"DocComment":" impl MyTrait for fn() -> std::convert::Infallible {}"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" With `Infallible` being an enum, this code is valid."},{"DocComment":" However when `Infallible` becomes an alias for the never type,"},{"DocComment":" the two `impl`s will start to overlap"},{"DocComment":" and therefore will be disallowed by the language\u2019s trait coherence rules."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Enum":[]},"layout":[{"key":"aarch64-apple-darwin","value":{"size":{"guarantee":null,"chosen":0},"align":{"guarantee":null,"chosen":1},"discriminator":null,"uninhabited":true,"variant_layouts":[],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"},{"def_id":15,"item_meta":{"name":[{"Ident":["zetesis_ferraris",0]},{"Ident":["oracle",0]},{"Ident":["evaluate",0]},{"Builtin":["Closure",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":128,"col":47},"end":{"line":128,"col":65}},"generated_from_span":null}},"source_text":"|mask| mask[index]","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"generics":{"regions":[{"index":0,"name":null,"variance":"Unknown","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":{"Closure":{"info":{"kind":"FnOnce","fn_once_impl":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"skip_binder":{"id":6,"generics":{"regions":[{"Var":{"Free":0}},{"Var":{"Bound":[0,0]}}],"types":[],"const_generics":[],"trait_refs":[]}}},"fn_mut_impl":null,"fn_impl":null,"signature":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"skip_binder":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[23,{"Ref":[{"Var":{"Bound":[0,0]}},{"Value":[24,{"Slice":[{"Deduplicated":13},null]}]},"Shared"]}]}],"output":{"Deduplicated":13}}}}}},"kind":{"Struct":[{"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":128,"col":47},"end":{"line":128,"col":65}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"_0","is_positional":true,"ty":{"Value":[25,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":0},"Shared"]}]}}]},"layout":[{"key":"aarch64-apple-darwin","value":{"size":{"guarantee":null,"chosen":8},"align":{"guarantee":null,"chosen":8},"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0}],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"},{"def_id":16,"item_meta":{"name":[{"Ident":["zetesis_ferraris",0]},{"Ident":["reduct",0]},{"Ident":["FrozenReduct",0]}],"span":{"Untagged":{"data":{"file_id":30,"beg":{"line":28,"col":0},"end":{"line":31,"col":1}},"generated_from_span":null}},"source_text":"pub struct FrozenReduct<'a> {\n    candidate: &'a Interpretation,\n    truth: Vec<bool>,\n}","attr_info":{"attributes":[{"DocComment":" The Ferraris reduct of an immutable theory in one fixed interpretation."},{"DocComment":""},{"DocComment":" This value borrows the exact candidate, whose theory handle fixes the original"},{"DocComment":" formula DAG. It owns one Boolean per DAG node: that node's classical truth in"},{"DocComment":" the candidate. Testing the reduct masks every candidate-false subformula to"},{"DocComment":" falsum, without constructing another DAG or reevaluating the candidate."},{"DocComment":""},{"DocComment":" Freezing does not assert that the candidate models the original theory or is"},{"DocComment":" an answer set. A satisfaction query does not establish subset minimality."},{"DocComment":" The candidate and mask remain immutable, so independent callers can share the"},{"DocComment":" reduct; each query reserves its own temporary evaluation workspace."},{"DocComment":""},{"DocComment":" The mask cannot be supplied separately from the checked subject:"},{"DocComment":" ```compile_fail"},{"DocComment":" use zetesis_ferraris::{FrozenReduct, Interpretation};"},{"DocComment":" fn attach(candidate: &Interpretation, truth: Vec<bool>) -> FrozenReduct<'_> {"},{"DocComment":"     FrozenReduct { candidate, truth }"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"generics":{"regions":[{"index":0,"name":"'a","variance":"Covariant","mutability":"Shared"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[{"span":{"Untagged":{"data":{"file_id":30,"beg":{"line":29,"col":4},"end":{"line":29,"col":33}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"candidate","is_positional":false,"ty":{"Value":[26,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":7},"Shared"]}]}},{"span":{"Untagged":{"data":{"file_id":30,"beg":{"line":30,"col":4},"end":{"line":30,"col":20}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"truth","is_positional":false,"ty":{"Value":[27,{"Adt":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":13}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}}]},"layout":[{"key":"aarch64-apple-darwin","value":{"size":{"guarantee":null,"chosen":32},"align":{"guarantee":null,"chosen":8},"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":24},{"guarantee":null,"chosen":0}],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"},null,null,null,{"def_id":20,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["sync",0]},{"Ident":["Arc",0]}],"span":{"Untagged":{"data":{"file_id":31,"beg":{"line":274,"col":0},"end":{"line":277,"col":1}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A thread-safe reference-counting pointer. 'Arc' stands for 'Atomically"},{"DocComment":" Reference Counted'."},{"DocComment":""},{"DocComment":" The type `Arc<T>` provides shared ownership of a value of type `T`,"},{"DocComment":" allocated in the heap. Invoking [`clone`][clone] on `Arc` produces"},{"DocComment":" a new `Arc` instance, which points to the same allocation on the heap as the"},{"DocComment":" source `Arc`, while increasing a reference count. When the last `Arc`"},{"DocComment":" pointer to a given allocation is destroyed, the value stored in that allocation (often"},{"DocComment":" referred to as \"inner value\") is also dropped."},{"DocComment":""},{"DocComment":" Shared references in Rust disallow mutation by default, and `Arc` is no"},{"DocComment":" exception: you cannot generally obtain a mutable reference to something"},{"DocComment":" inside an `Arc`. If you do need to mutate through an `Arc`, you have several options:"},{"DocComment":""},{"DocComment":" 1. Use interior mutability with synchronization primitives like [`Mutex`][mutex],"},{"DocComment":"    [`RwLock`][rwlock], or one of the [`Atomic`][atomic] types."},{"DocComment":""},{"DocComment":" 2. Use clone-on-write semantics with [`Arc::make_mut`] which provides efficient mutation"},{"DocComment":"    without requiring interior mutability. This approach clones the data only when"},{"DocComment":"    needed (when there are multiple references) and can be more efficient when mutations"},{"DocComment":"    are infrequent."},{"DocComment":""},{"DocComment":" 3. Use [`Arc::get_mut`] when you know your `Arc` is not shared (has a reference count of 1),"},{"DocComment":"    which provides direct mutable access to the inner value without any cloning."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::Arc;"},{"DocComment":""},{"DocComment":" let mut data = Arc::new(vec![1, 2, 3]);"},{"DocComment":""},{"DocComment":" // This will clone the vector only if there are other references to it"},{"DocComment":" Arc::make_mut(&mut data).push(4);"},{"DocComment":""},{"DocComment":" assert_eq!(*data, vec![1, 2, 3, 4]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" **Note**: This type is only available on platforms that support atomic"},{"DocComment":" loads and stores of pointers, which includes all platforms that support"},{"DocComment":" the `std` crate but not all those which only support [`alloc`](crate)."},{"DocComment":" This may be detected at compile time using `#[cfg(target_has_atomic = \"ptr\")]`."},{"DocComment":""},{"DocComment":" ## Thread Safety"},{"DocComment":""},{"DocComment":" Unlike [`Rc<T>`], `Arc<T>` uses atomic operations for its reference"},{"DocComment":" counting. This means that it is thread-safe. The disadvantage is that"},{"DocComment":" atomic operations are more expensive than ordinary memory accesses. If you"},{"DocComment":" are not sharing reference-counted allocations between threads, consider using"},{"DocComment":" [`Rc<T>`] for lower overhead. [`Rc<T>`] is a safe default, because the"},{"DocComment":" compiler will catch any attempt to send an [`Rc<T>`] between threads."},{"DocComment":" However, a library might choose `Arc<T>` in order to give library consumers"},{"DocComment":" more flexibility."},{"DocComment":""},{"DocComment":" `Arc<T>` will implement [`Send`] and [`Sync`] as long as the `T` implements"},{"DocComment":" [`Send`] and [`Sync`]. Why can't you put a non-thread-safe type `T` in an"},{"DocComment":" `Arc<T>` to make it thread-safe? This may be a bit counter-intuitive at"},{"DocComment":" first: after all, isn't the point of `Arc<T>` thread safety? The key is"},{"DocComment":" this: `Arc<T>` makes it thread safe to have multiple ownership of the same"},{"DocComment":" data, but it  doesn't add thread safety to its data. Consider"},{"DocComment":" <code>Arc<[RefCell\\<T>]></code>. [`RefCell<T>`] isn't [`Sync`], and if `Arc<T>` was always"},{"DocComment":" [`Send`], <code>Arc<[RefCell\\<T>]></code> would be as well. But then we'd have a problem:"},{"DocComment":" [`RefCell<T>`] is not thread safe; it keeps track of the borrowing count using"},{"DocComment":" non-atomic operations."},{"DocComment":""},{"DocComment":" In the end, this means that you may need to pair `Arc<T>` with some sort of"},{"DocComment":" [`std::sync`] type, usually [`Mutex<T>`][mutex]."},{"DocComment":""},{"DocComment":" ## Breaking cycles with `Weak`"},{"DocComment":""},{"DocComment":" The [`downgrade`][downgrade] method can be used to create a non-owning"},{"DocComment":" [`Weak`] pointer. A [`Weak`] pointer can be [`upgrade`][upgrade]d"},{"DocComment":" to an `Arc`, but this will return [`None`] if the value stored in the allocation has"},{"DocComment":" already been dropped. In other words, `Weak` pointers do not keep the value"},{"DocComment":" inside the allocation alive; however, they *do* keep the allocation"},{"DocComment":" (the backing store for the value) alive."},{"DocComment":""},{"DocComment":" A cycle between `Arc` pointers will never be deallocated. For this reason,"},{"DocComment":" [`Weak`] is used to break cycles. For example, a tree could have"},{"DocComment":" strong `Arc` pointers from parent nodes to children, and [`Weak`]"},{"DocComment":" pointers from children back to their parents."},{"DocComment":""},{"DocComment":" # Cloning references"},{"DocComment":""},{"DocComment":" Creating a new reference from an existing reference-counted pointer is done using the"},{"DocComment":" `Clone` trait implemented for [`Arc<T>`][Arc] and [`Weak<T>`][Weak]."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::Arc;"},{"DocComment":" let foo = Arc::new(vec![1.0, 2.0, 3.0]);"},{"DocComment":" // The two syntaxes below are equivalent."},{"DocComment":" let a = foo.clone();"},{"DocComment":" let b = Arc::clone(&foo);"},{"DocComment":" // a, b, and foo are all Arcs that point to the same memory location"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## `Deref` behavior"},{"DocComment":""},{"DocComment":" `Arc<T>` automatically dereferences to `T` (via the [`Deref`] trait),"},{"DocComment":" so you can call `T`'s methods on a value of type `Arc<T>`. To avoid name"},{"DocComment":" clashes with `T`'s methods, the methods of `Arc<T>` itself are associated"},{"DocComment":" functions, called using [fully qualified syntax]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::Arc;"},{"DocComment":""},{"DocComment":" let my_arc = Arc::new(());"},{"DocComment":" let my_weak = Arc::downgrade(&my_arc);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `Arc<T>`'s implementations of traits like `Clone` may also be called using"},{"DocComment":" fully qualified syntax. Some people prefer to use fully qualified syntax,"},{"DocComment":" while others prefer using method-call syntax."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::Arc;"},{"DocComment":""},{"DocComment":" let arc = Arc::new(());"},{"DocComment":" // Method-call syntax"},{"DocComment":" let arc2 = arc.clone();"},{"DocComment":" // Fully qualified syntax"},{"DocComment":" let arc3 = Arc::clone(&arc);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`Weak<T>`][Weak] does not auto-dereference to `T`, because the inner value may have"},{"DocComment":" already been dropped."},{"DocComment":""},{"DocComment":" [`Rc<T>`]: crate::rc::Rc"},{"DocComment":" [clone]: Clone::clone"},{"DocComment":" [mutex]: ../../std/sync/struct.Mutex.html"},{"DocComment":" [rwlock]: ../../std/sync/struct.RwLock.html"},{"DocComment":" [atomic]: core::sync::atomic"},{"DocComment":" [downgrade]: Arc::downgrade"},{"DocComment":" [upgrade]: Weak::upgrade"},{"DocComment":" [RefCell\\<T>]: core::cell::RefCell"},{"DocComment":" [`RefCell<T>`]: core::cell::RefCell"},{"DocComment":" [`std::sync`]: ../../std/sync/index.html"},{"DocComment":" [`Arc::clone(&from)`]: Arc::clone"},{"DocComment":" [fully qualified syntax]: https://doc.rust-lang.org/book/ch19-03-advanced-traits.html#fully-qualified-syntax-for-disambiguation-calling-methods-with-the-same-name"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Sharing some immutable data between threads:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::Arc;"},{"DocComment":" use std::thread;"},{"DocComment":""},{"DocComment":" let five = Arc::new(5);"},{"DocComment":""},{"DocComment":" for _ in 0..10 {"},{"DocComment":"     let five = Arc::clone(&five);"},{"DocComment":""},{"DocComment":"     thread::spawn(move || {"},{"DocComment":"         println!(\"{five:?}\");"},{"DocComment":"     });"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Sharing a mutable [`AtomicUsize`]:"},{"DocComment":""},{"DocComment":" [`AtomicUsize`]: core::sync::atomic::AtomicUsize \"sync::atomic::AtomicUsize\""},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::Arc;"},{"DocComment":" use std::sync::atomic::{AtomicUsize, Ordering};"},{"DocComment":" use std::thread;"},{"DocComment":""},{"DocComment":" let val = Arc::new(AtomicUsize::new(5));"},{"DocComment":""},{"DocComment":" for _ in 0..10 {"},{"DocComment":"     let val = Arc::clone(&val);"},{"DocComment":""},{"DocComment":"     thread::spawn(move || {"},{"DocComment":"         let v = val.fetch_add(1, Ordering::Relaxed);"},{"DocComment":"         println!(\"{v:?}\");"},{"DocComment":"     });"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" See the [`rc` documentation][rc_examples] for more examples of reference"},{"DocComment":" counting in general."},{"DocComment":""},{"DocComment":" [rc_examples]: crate::rc#examples"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Arc"},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_met