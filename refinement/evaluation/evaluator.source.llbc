\n            statistics: work.statistics,\n        });\n    }\n    let mut selected = reserve(theory.atom_count())?;\n    select_atoms(theory, candidate, &mut selected, &mut work)?;\n    let mut words = reserve(candidate.words.len())?;\n    words.resize(candidate.words.len(), 0);\n    let mut subset = Interpretation {\n        theory: theory.clone(),\n        words,\n    };\n    let mut values = reserve(theory.nodes().len())?;\n    let verdict = if find_countermodel(\n        theory,\n        &frozen,\n        &selected,\n        &mut subset,\n        &mut values,\n        &mut work,\n    )? {\n        Verdict::NonMinimal { witness: subset }\n    } else {\n        Verdict::Stable\n    };\n    Ok(Check {\n        verdict,\n        statistics: work.statistics,\n    })\n}","attr_info":{"attributes":[{"DocComment":" Decide stable-model membership by classical satisfaction and exhaustive"},{"DocComment":" proper-subset checking of the Ferraris formula reduct. This reference kernel"},{"DocComment":" is exponential in the candidate size and does not assume a least reduct model."},{"DocComment":""},{"DocComment":" # Errors"},{"DocComment":" Refuses foreign candidates, cancellation, deadlines, allocation, or exhausted"},{"DocComment":" work/subset bounds. A subset bound uses `Stop::CandidateLimit` because it"},{"DocComment":" bounds candidate countermodels; no partial search returns `Stable`."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":67},{"Deduplicated":68