ttributes":[{"DocComment":" Another complete source round would exceed the round ceiling."}],"inline":null,"rename":null,"public":true},"name":"RoundLimit","fields":[],"discriminant":{"Signed":["Isize","3"]}},{"id":4,"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":144,"col":4},"end":{"line":144,"col":16}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" Named live closure storage would exceed its byte ceiling."}],"inline":null,"rename":null,"public":true},"name":"StorageLimit","fields":[],"discriminant":{"Signed":["Isize","4"]}},{"id":5,"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":146,"col":4},"end":{"line":146,"col":20}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" Adding another distinct consequence would exceed the atom ceiling."}],"inline":null,"rename":null,"public":true},"name":"DerivedAtomLimit","fields":[],"discriminant":{"Signed":["Isize","5"]}},{"id":6,"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":148,"col":4},"end":{"line":148,"col":18}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" Producing another candidate would exceed the candidate ceiling."}],"inline":null,"rename":null,"public":true},"name":"CandidateLimit","fields":[],"discriminant":{"Signed":["Isize","6"]}},{"id":7,"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":150,"col":4},"end":{"line":150,"col":16}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" Discovering another carrier atom would exceed its ceiling."}],"inline":null,"rename":null,"public":true},"name":"CarrierLimit","fields":[],"discriminant":{"Signed":["Isize","7"]}},{"id":8,"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":152,"col":4},"end":{"line":152,"col":14}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" A fallible vector or carrier allocation was refused."}],"inline":null,"rename":null,"public":true},"name":"Allocation","fields":[],"discriminant":{"Signed":["Isize","8"