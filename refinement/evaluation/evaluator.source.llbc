Exhaustive":{"Untagged":{"data":{"file_id":68,"beg":{"line":464,"col":0},"end":{"line":464,"col":17}},"generated_from_span":null}}}}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Ordering"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Enum":[{"id":0,"span":{"Untagged":{"data":{"file_id":68,"beg":{"line":473,"col":4},"end":{"line":473,"col":11}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" No ordering constraints, only atomic operations."},{"DocComment":""},{"DocComment":" Corresponds to [`memory_order_relaxed`] in C++20."},{"DocComment":""},{"DocComment":" [`memory_order_relaxed`]: https://en.cppreference.com/w/cpp/atomic/memory_order#Relaxed_ordering"}],"inline":null,"rename":null,"public":true},"name":"Relaxed","fields":[],"discriminant":{"Signed":["Isize","0"]}},{"id":1,"span":{"Untagged":{"data":{"file_id":68,"beg":{"line":488,"col":4},"end":{"line":488,"col":11}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" When coupled with a store, all previous operations become ordered"},{"DocComment":" before any load of this value with [`Acquire`] (or stronger) ordering."},{"DocComment":" In particular, all previous writes become visible to all threads"},{"DocComment":" that perform an [`Acquire`] (or stronger) load of this value."},{"DocComment":""},{"DocComment":" Notice that using this ordering for an operation that combines loads"},{"DocComment":" and stores leads to a [`Relaxed`] load operation!"},{"DocComment":""},{"DocComment":" This ordering is only applicable for operations that can perform a store."},{"DocComment":""},{"DocComment":" Corresponds to [`memory_order_release`] in C++20."},{"DocComment":""},{"DocComment":" [`memory_order_release`]: https://en.cppreference.com/w/cpp/atomic/memory_order#Release-Acquire_ordering"}],"inline":null,"rename":null,"public":true},"name":"Release","fields":[],"discriminant":{"Signed":["Isize","1"]}},{"id":2,"span":{"Untagged":{"data":{"file_id":68,"beg":{"line":503,"col":4},"end":{"line":503,"col":11}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" When coupled with a load, if the loaded value was written by a store operation with"},{"DocComment":" [`Release`] (or stronger) ordering, then all subsequent operations"},{"DocComment":" become ordered after that store. In particular, all subsequent loads will see data"},{"DocComment":" written before the store."},{"DocComment":""},{"DocComment":" Notice that using this ordering for an operation that combines loads"},{"DocComment":" and stores leads to a [`Relaxed`] store operation!"},{"DocComment":""},{"DocComment":" This ordering is only applicable for operations that can perform a load."},{"DocComment":""},{"DocComment":" Corresponds to [`memory_order_acquire`] in C++20."},{"DocComment":""},{"DocComment":" [`memory_order_acquire`]: https://en.cppreference.com/w/cpp/atomic/memory_order#Release-Acquire_ordering"}],"inline":null,"rename":null,"public":true},"name":"Acquire","fields":[],"discriminant":{"Signed":["Isize","2"]}},{"id":3,"span":{"Untagged":{"data":{"file_id":68,"beg":{"line":517,"col":4},"end":{"line":517,"col":10}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" Has the effects of both [`Acquire`] and [`Release`] together:"},{"DocComment":" For loads it uses [`Acquire`] ordering. For stores it uses the [`Release`] ordering."},{"DocComment":""},{"DocComment":" Notice that in the case of `compare_and_swap`, it is possible that the operation ends up"},{"DocComment":" not performing any store and hence it has just [`Acquire`] ordering. However,"},{"DocComment":" `AcqRel` will never perform [`Relaxed`] accesses."},{"DocComment":""},{"DocComment":" This ordering is only applicable for operations that combine both loads and stores."},{"DocComment":""},{"DocComment":" Corresponds to [`memory_order_acq_rel`] in C++20."},{"DocComment":""},{"DocComment":" [`memory_order_acq_rel`]: https://en.cppreference.com/w/cpp/atomic/memory_order#Release-Acquire_ordering"}],"inline":null,"rename":null,"public":true},"name":"AcqRel","fields":[],"discriminant":{"Signed":["Isize","3"]}},{"id":4,"span":{"Untagged":{"data":{"file_id":68,"beg":{"line":526,"col":4},"end":{"line":526,"col":10}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" Like [`Acquire`]/[`Release`]/[`AcqRel`] (for load, store, and load-with-store"},{"DocComment":" operations, respectively) with the additional guarantee that all threads see all"},{"DocComment":" sequentially consistent operations in the same order."},{"DocComment":""},{"DocComment":" Corresponds to [`memory_order_seq_cst`] in C++20."},{"DocComment":""},{"DocComment":" [`memory_order_seq_cst`]: https://en.cppreference.com/w/cpp/atomic/memory_order#Sequentially-consistent_ordering"}],"inline":null,"rename":null,"public":true},"name":"SeqCst","fields":[],"discriminant":{"Signed":["Isize","4"]}}]},"layout":[{"key":"aarch64-apple-darwin","value":{"size":{"guarantee":null,"chosen":1},"align":{"guarantee":null,"chosen":1},"discriminator":{"Branch":{"offset":{"guarantee":null,"chosen":0},"int_ty":{"Unsigned":"U8"},"children":[[{"start":{"Unsigned":["U8","0"]},"end":{"Unsigned":["U8","0"]}},{"Known":0}],[{"start":{"Unsigned":["U8","1"]},"end":{"Unsigned":["U8","1"]}},{"Known":1}],[{"start":{"Unsigned":["U8","2"]},"end":{"Unsigned":["U8","2"]}},{"Known":2}],[{"start":{"Unsigned":["U8","3"]},"end":{"Unsigned":["U8","3"]}},{"Known":3}],[{"start":{"Unsigned":["U8","4"]},"end":{"Unsigned":["U8","4"]}},{"Known":4}]],"fallback":"Invalid"}},"uninhabited":false,"variant_layouts":[{"field_offsets":[],"uninhabited":false,"tagger":[[0,{"Unsigned":["U8","0"]}]]},{"field_offsets":[],"uninhabited":false,"tagger":[[0,{"Unsigned":["U8","1"]}]]},{"field_offsets":[],"uninhabited":false,"tagger":[[0