ment":""},{"DocComment":" This ordering is only applicable for operations that combine both loads and stores."},{"DocComment":""},{"DocComment":" Corresponds to [`memory_order_acq_rel`] in C++20."},{"DocComment":""},{"DocComment":" [`memory_order_acq_rel`]: https://en.cppreference.com/w/cpp/atomic/memory_order#Release-Acquire_ordering"}],"inline":null,"rename":null,"public":true},"name":"AcqRel","fields":[],"discriminant":{"Signed":["Isize","3"]}},{"id":4,"span":{"Untagged":{"data":{"file_id":65,"beg":{"line":526,"col":4},"end":{"line":526,"col":10}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" Like [`Acquire`]/[`Release`]/[`AcqRel`] (for load, store, and load-with-store"},{"DocComment":" operations, respectively) with the additional guarantee that all threads see all"},{"DocComment":" sequentially consistent operations in the same order."},{"DocComment":""},{"DocComment":" Corresponds to [`memory_order_seq_cst`] in C++20."},{"DocComment":""},{"DocComment":" [`memory_order_seq_cst`]: https://en.cppreference.com/w/cpp/atomic/memory_order#Sequentially-consistent_ordering"}],"inline":null,"rename":null,"public":true},"name":"SeqCst","fields":[],"discriminant":{"Signed":["Isize","4"]}}]},"layout":[{"key":"aarch64-apple-darwin","value":{"size":{"guarantee":null,"chosen":1},"align":{"guarantee":null,"chosen":1},"discriminator":{"Branch":{"offset":{"guarantee":null,"chosen":0},"int_ty":{"Unsigned":"U8"},"children":[[{"start":{"Unsigned":["U8","0"]},"end":{"Unsigned":["U8","0"]}},{"Known":0}],[{"start":{"Unsigned":["U8","1"]},"end":{"Unsigned":["U8","1"]}},{"Known":1}],[{"start":{"Unsigned":["U8","2"]},"end":{"Unsigned":["U8","2"]}},{"Known":2}],[{"start":{"Unsigned":["U8","3"]},"end":{"Unsigned":["U8","3"]}},{"Known":3}],[{"start":{"Unsigned":["U8","4"]},"end":{"Unsigned":["U8","4"]}},{"Known":4}]],"fallback":"Invalid"}},"uninhabited":false,"variant_layouts":[{"field_offsets":[],"uninhabited":false,"tagger":[[0,{"Unsigned":["U8","0"]}]]},{"field_