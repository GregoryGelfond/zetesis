},"end":{"line":18,"col":1}},"generated_from_span":null}},"source_text":"pub enum Node {\n    /// A proposition in the theory's finite atom universe.\n    Atom(usize),\n    /// Falsum.\n    False,\n    /// Conjunction of two preceding nodes.\n    And(usize, usize),\n    /// Disjunction of two preceding nodes.\n    Or(usize, usize),\n    /// Classical implication between two preceding nodes.\n    Implies(usize, usize),\n}","attr_info":{"attributes":[{"DocComment":" A Boolean circuit node. Connectives refer only to preceding node indices."},{"DocComment":" Default negation is implication to falsum, not a complement in the reduct."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Enum":[{"id":0,"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":9,"col":4},"end":{"line":9,"col":8}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" A proposition in the theory's finite atom universe."}],"inline":null,"rename":null,"public":true},"name":"Atom","fields":[{"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":9,"col":9},"end":{"line":9,"col":14}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"_0","is_positional":true,"ty":{"Deduplicated":0}}],"discriminant":{"Signed":["Isize","0"]}},{"id":1,"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":11,"col":4},"end":{"line":11,"col":9}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" Falsum."}],"inline":null,"rename":null,"public":true},"name":"False","fields":[],"discriminant":{"Signed":["Isize","1"]}},{"id":2,"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":13,"col":4},"end":{"line":13,"col":7}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" Con