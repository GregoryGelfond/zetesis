g":{"line":111,"col":0},"end":{"line":111,"col":16}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The error type which is returned from formatting a message into a stream."},{"DocComment":""},{"DocComment":" This type does not support transmission of an error other than that an error"},{"DocComment":" occurred. This is because, despite the existence of this error,"},{"DocComment":" string formatting is considered an infallible operation."},{"DocComment":" `fmt()` implementors should not return this `Error` unless they received it from their"},{"DocComment":" [`Formatter`]. The only time your code should create a new instance of this"},{"DocComment":" error is when implementing `fmt::Write`, in order to cancel the formatting operation when"},{"DocComment":" writing to the underlying stream fails."},{"DocComment":""},{"DocComment":" Any extra information must be arranged to be transmitted through some other means,"},{"DocComment":" such as storing it in a field to be consulted after the formatting operation has been"},{"DocComment":" cancelled. (For example, this is how [`std::io::Write::write_fmt()`] propagates IO errors"},{"DocComment":" during writing.)"},{"DocComment":""},{"DocComment":" This type, `fmt::Error`, should not be"},{"DocComment":" confused with [`std::io::Error`] or [`std::error::Error`], which you may also"},{"DocComment":" have in scope."},{"DocComment":""},{"DocComment":" [`std::io::Error`]: ../../std/io/struct.Error.html"},{"DocComment":" [`std::io::Write::write_fmt()`]: ../../std/io/trait.Write.html#method.write_fmt"},{"DocComment":" [`std::error::Error`]: ../../std/error/trait.Error.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::fmt::{self, write};"},{"DocComment":""},{"DocComment":" let mut output = String::new();"},{"DocComment":" if let Err(fmt::Error) = write(&mut output, format_args!(\"Hello {}!\", \"world\")) {"},{"DocComment":"     panic!(\"An error occurred\");"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[]},"layout":[{"key":"aarch64-apple-darwin","value":{"size":{"guarantee":null,"chosen":0},"align":{"guarantee":null,"chosen":1},"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"},null,{"def_id":82,"item_meta":{"name":[{"Ident":["std",0]},{"Ident":["time",0]},{"Ident":["Instant",0]}],"span":{"Untagged":{"data":{"file_id":76,"beg":{"line":156,"col":0},"end":{"line":156,"col":18}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A measurement of a monotonically nondecreasing clock."},{"DocComment":" Opaque and useful only with [`Duration`]."},{"DocComment":""},{"DocComment":" Instants are always guaranteed, barring [platform bugs], to be no less than any previously"},{"DocComment":" measured instant when created, and are often useful for tasks such as measuring"},{"DocComment":" benchmarks or timing how long an operation takes."},{"DocComment":""},{"DocComment":" Note, however, that instants are **not** guaranteed to be **steady**. In other"},{"DocComment":" words, each tick of the underlying clock might not be the same length (e.g."},{"DocComment":" some seconds may be longer than others). An instant may jump forwards or"},{"DocComment":" experience time dilation (slow down or speed up), but it will never go"},{"DocComment":" backwards."},{"DocComment":" As part of this non-guarantee it is also not specified whether system suspends count as"},{"DocComment":" elapsed time or not. The behavior varies across platforms and Rust versions."},{"DocComment":""},{"DocComment":" Instants are opaque types that can only be compared to one another. There is"},{"DocComment":" no method to get \"the number of seconds\" from an instant. Instead, it only"},{"DocComment":" allows measuring the duration between two instants (or comparing two"},{"DocComment":" instants)."},{"DocComment":""},{"DocComment":" The size of an `Instant` struct may vary depending on the target operating"},{"DocComment":" system."},{"DocComment":""},{"DocComment":" Example:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::time::{Duration, Instant};"},{"DocComment":" use std::thread::sleep;"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"    let now = Instant::now();"},{"DocComment":""},{"DocComment":"    // we sleep for 2 seconds"},{"DocComment":"    sleep(Duration::new(2, 0));"},{"DocComment":"    // it prints '2'"},{"DocComment":"    println!(\"{}\", now.elapsed().as_secs());"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [platform bugs]: Instant#monotonicity"},{"DocComment":""},{"DocComment":" # OS-specific behaviors"},{"DocComment":""},{"DocComment":" An `Instant` is a wrapper around system-specific types and it may behave"},{"DocComment":" differently depending on the underlying operating system. For example,"},{"DocComment":" the following snippet is fine on Linux but panics on macOS:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::time::{Instant, Duration};"},{"DocComment":""},{"DocComment":" let now = Instant::now();"},{"DocComment":" let days_per_10_millennia = 365_2425;"},{"DocComment":" let solar_seconds_per_day = 60 * 60 * 24;"},{"DocComment":" let millennium_in_solar_seconds = 31_556_952_000;"},{"DocComment":" assert_eq!(millennium_in_solar_seconds, days_per_10_millennia * solar_seconds_per_day / 10);"},{"DocComment":""},{"DocComment":" let duration = Duration::new(millennium_in_solar_seconds, 0);"},{"DocComment":" println!(\"{:?}\", now + duration);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" For cross-platform code, you can comfortably use durations of up to around one hundred years."},{"DocComment":""},{"DocComment":" # Underlying System calls"},{"DocComment":""},{"DocComment":" The following system calls are [currently] being used by `now()` to find out"},{"DocComment":" the current time:"},{"DocComment":""},{"DocComment":" |  Platform |               System call                                            |"},{"DocComment":" |-----------|----------------------------------------------------------------------|"},{"DocComment":" | SGX       | [`insecure_time` usercall]. More information on [timekeeping in SGX] |"},{"DocComment":" | UNIX      | [clock_gettime] with `CLOCK_MONOTONIC`                               |"},{"DocComment":" | WASI      | [clock_gettime] with `CLOCK_MONOTONIC`                               |"},{"DocComment":" | Darwin    | [clock_gettime] with `CLOCK_UPTIME_RAW`                              |"},{"DocComment":" | VXWorks   | [clock_gettime] with `CLOCK_MONOTONIC`                               |"},{"DocComment":" | SOLID     | `get_tim`                                                            |"},{"DocComment":" | Windows   | [QueryPerformanceCounter]                                            |"},{"DocComment":""},{"DocComment":" [currently]: crate::io#platform-specific-behavior"},{"DocComment":" [QueryPerformanceCounter]: https://docs.microsoft.com/en-us/windows/win32/api/profileapi/nf-profileapi-queryperformancecounter"},{"DocComment":" [`insecure_time` usercall]: https://edp.fortanix.com/docs/api/fortanix_sgx_abi/struct.Usercalls.html#method.insecure_time"},{"DocComment":" [timekeeping in SGX]: https://edp.fortanix.com/docs/concepts/rust-std/#codestdtimecode"},{"DocComment":" [clock_gettime]: https://pubs.opengroup.org/onlinepubs/9799919799/functions/clock_getres.html"},{"DocComment":""},{"DocComment":" **Disclaimer:** These system calls might change over time."},{"DocComment":""},{"DocComment":" > Note: mathematical operations like [`add`] may panic if the underlying"},{"DocComment":" > structure cannot represent the new point in time."},{"DocComment":""},{"DocComment":" [`add`]: Instant::add"},{"DocComment":""},{"DocComment":" ## Monotonicity"},{"DocComment":""},{"DocComment":" On all platforms `Instant` will try to use an OS API that guarantees monotonic behavior"},{"DocComment":" if available, which is the case for all [tier 1] platforms."},{"DocComment":" In practice such guarantees are \u2013 under rare circumstances \u2013 broken by hardware, virtualization"},{"DocComment":" or operating system bugs. To work around these bugs and platforms not offering monotonic clocks"},{"DocComment":" [`duration_since`], [`elapsed`] and [`sub`](#impl-Sub-for-Instant) saturate to zero. In older"},{"DocComment":" Rust versions this lead to a panic instead. [`checked_duration_since`] can be used to detect and"},{"DocComment":" handle situations where monotonicity is violated, or `Instant`s are subtracted in the wrong order."},{"DocComment":""},{"DocComment":" This workaround obscures programming errors where earlier and later instants are accidentally"},{"DocComment":" swapped. For this reason future Rust versions may reintroduce panics."},{"DocComment":""},{"DocComment":" [tier 1]: https://doc.rust-lang.org/rustc/platform-support.html"},{"DocComment":" [`duration_since`]: Instant::duration_since"},{"DocComment":" [`elapsed`]: Instant::elapsed"},{"DocComment":" [`sub`]: Instant::sub"},{"DocComment":" [`checked_duration_since`]: Instant::checked_duration_since"},{"DocComment":""}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Instant"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"aarch64-apple-darwin","value":{"size":{"guarantee":null,"chosen":16},"align":{"guarantee":null,"chosen":8},"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0}],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"},{"def_id":83,"item_meta":{"name":[{"Ident":["std",0]},{"Ident":["sync",0]},{"Ident":["poison",0]},{"Ident":["mutex",0]},{"Ident":["Mutex",0]}],"span":{"Untagged":{"data":{"file_id":78,"beg":{"line":227,"col":0},"end":{"line":227,"col":27}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A mutual exclusion primitive useful for protecting shared data"},{"DocComment":""},{"DocComment":" This mutex will block threads waiting for the lock to become available. The"},{"DocComment":" mutex can be created via a [`new`] constructor. Each mutex has a type parameter"},{"DocComment":" which represents the data that it is protecting. The data can only be accessed"},{"DocComment":" through the RAII guards returned from [`lock`] and [`try_lock`], which"},{"DocComment":" guarantees that the data is only ever accessed when the mutex is locked."},{"DocComment":""},{"DocComment":" # Poisoning"},{"DocComment":""},{"DocComment":" The mutexes in this module implement a strategy called \"poisoning\" where a"},{"DocComment":" mutex becomes poisoned if it recognizes that the thread holding it has"},{"DocComment":" panicked."},{"DocComment":""},{"DocComment":" Once a mutex is poisoned, all other threads are unable to access the data by"},{"DocComment":" default as it is likely tainted (some invariant is not being upheld). For a"},{"DocComment":" mutex, this means that the [`lock`] and [`try_lock`] methods return a"},{"DocComment":" [`Result`] which indicates whether a mutex has been poisoned or not. Most"},{"DocComment":" usage of a mutex will simply [`unwrap()`] these results, propagating panics"},{"DocComment":" among threads to ensure that a possibly invalid invariant is not witnessed."},{"DocComment":""},{"DocComment":" Poisoning is only advisory: the [`PoisonError`] type has an [`into_inner`]"},{"DocComment":" method which will return the guard that would have otherwise been returned"},{"DocComment":" on a successful lock. This allows access to the data, despite the lock being"},{"DocComment":" poisoned."},{"DocComment":""},{"DocComment":" In addition, the panic detection is not ideal, so even unpoisoned mutexes"},{"DocComment":" need to be handled with care, since certain panics may have been skipped."},{"DocComment":" Here is a non-exhaustive list of situations where this might occur:"},{"DocComment":""},{"DocComment":" - If a mutex is locked while a panic is underway, e.g. within a [`Drop`]"},{"DocComment":"   implementation or a [panic hook], panicking for the second time while the"},{"DocComment":"   lock is held will leave the mutex unpoisoned. Note that while double panic"},{"DocComment":"   usually aborts the program, [`catch_unwind`] can prevent this."},{"DocComment":""},{"DocComment":" - Locking and unlocking the mutex across different panic contexts, e.g. by"},{"DocComment":"   storing the guard to a [`Cell`] within [`Drop::drop`] and accessing it"},{"DocComment":"   outside, or vice versa, can affect poisoning status in an unexpected way."},{"DocComment":""},{"DocComment":" - Foreign exceptions do not currently trigger poisoning even in absence of"},{"DocComment":"   other panics."},{"DocComment":""},{"DocComment":" While this rarely happens in realistic code, `unsafe` code cannot rely on"},{"DocComment":" poisoning for soundness, since the behavior of poisoning can depend on"},{"DocComment":" outside context. Here's an example of **incorrect** use of poisoning:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::sync::Mutex;"},{"DocComment":""},{"DocComment":" struct MutexBox<T> {"},{"DocComment":"     data: Mutex<*mut T>,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<T> MutexBox<T> {"},{"DocComment":"     pub fn new(value: T) -> Self {"},{"DocComment":"         Self {"},{"DocComment":"             data: Mutex::new(Box::into_raw(Box::new(value))),"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     pub fn replace_with(&self, f: impl FnOnce(T) -> T) {"},{"DocComment":"         let ptr = self.data.lock().expect(\"poisoned\");"},{"DocComment":"         // While `f` is running, the data is moved out of `*ptr`. If `f`"},{"DocComment":"         // panics, `*ptr` keeps pointing at a dropped value. The intention"},{"DocComment":"         // is that this will poison the mutex, so the following calls to"},{"DocComment":"         // `replace_with` will panic without reading `*ptr`. But since"},{"DocComment":"         // poisoning is not guaranteed to occur if this is run from a panic"},{"DocComment":"         // hook, this can lead to use-after-free."},{"DocComment":"         unsafe {"},{"DocComment":"             (*ptr).write(f((*ptr).read()));"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`new`]: Self::new"},{"DocComment":" [`lock`]: Self::lock"},{"DocComment":" [`try_lock`]: Self::try_lock"},{"DocComment":" [`unwrap()`]: Result::unwrap"},{"DocComment":" [`PoisonError`]: super::PoisonError"},{"DocComment":" [`into_inner`]: super::PoisonError::into_inner"},{"DocComment":" [panic hook]: crate::panic::set_hook"},{"DocComment":" [`catch_unwind`]: crate::panic::catch_unwind"},{"DocComment":" [`Cell`]: crate::cell::Cell"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::{Arc, Mutex};"},{"DocComment":" use std::thread;"},{"DocComment":" use std::sync::mpsc::channel;"},{"DocComment":""},{"DocComment":" const N: usize = 10;"},{"DocComment":""},{"DocComment":" // Spawn a few threads to increment a shared variable (non-atomically), and"},{"DocComment":" // let the main thread know once all increments are done."},{"DocComment":" //"},{"DocComment":" // Here we're using an Arc to share memory among threads, and the data inside"},{"DocComment":" // the Arc is protected with a mutex."},{"DocComment":" let data = Arc::new(Mutex::new(0));"},{"DocComment":""},{"DocComment":" let (tx, rx) = channel();"},{"DocComment":" for _ in 0..N {"},{"DocComment":"     let (data, tx) = (Arc::clone(&data), tx.clone());"},{"DocComment":"     thread::spawn(move || {"},{"DocComment":"         // The shared state can only be accessed once the lock is held."},{"DocComment":"         // Our non-atomic increment is safe because we're the only thread"},{"DocComment":"         // which can access the shared state when the lock is held."},{"DocComment":"         //"},{"DocComment":"         // We unwrap() the return value to assert that we are not expecting"},{"DocComment":"         // threads to ever fail while holding the lock."},{"DocComment":"         let mut data = data.lock().unwrap();"},{"DocComment":"         *data += 1;"},{"DocComment":"         if *data == N {"},{"DocComment":"             tx.send(()).unwrap();"},{"DocComment":"         }"},{"DocComment":"         // the lock is unlocked here when `data` goes out of scope."},{"DocComment":"     });"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" rx.recv().unwrap();"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" To recover from a poisoned mutex:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::{Arc, Mutex};"},{"DocComment":" use std::thread;"},{"DocComment":""},{"DocComment":" let lock = Arc::new(Mutex::new(0_u32));"},{"DocComment":" let lock2 = Arc::clone(&lock);"},{"DocComment":""},{"DocComment":" let _ = thread::spawn(move || -> () {"},{"DocComment":"     // This thread will acquire the mutex first, unwrapping the result of"},{"DocComment":"     // `lock` because the lock has not been poisoned."},{"DocComment":"     let _guard = lock2.lock().unwrap();"},{"DocComment":""},{"DocComment":"     // This panic while holding the lock (`_guard` is in scope) will poison"},{"DocComment":"     // the mutex."},{"DocComment":"     panic!();"},{"DocComment":" }).join();"},{"DocComment":""},{"DocComment":" // The lock is poisoned by this point, but the returned result can be"},{"DocComment":" // pattern matched on to return the underlying guard on both branches."},{"DocComment":" let mut guard = match lock.lock() {"},{"DocComment":"     Ok(guard) => guard,"},{"DocComment":"     Err(poisoned) => poisoned.into_inner(),"},{"DocComment":" };"},{"DocComment":""},{"DocComment":" *guard += 1;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" To unlock a mutex guard sooner than the end of the enclosing scope,"},{"DocComment":" either create an inner scope or drop the guard manually."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::{Arc, Mutex};"},{"DocComment":" use std::thread;"},{"DocComment":""},{"DocComment":" const N: usize = 3;"},{"DocComment":""},{"DocComment":" let data_mutex = Arc::new(Mutex::new(vec![1, 2, 3, 4]));"},{"DocComment":" let res_mutex = Arc::new(Mutex::new(0));"},{"DocComment":""},{"DocComment":" let mut threads = Vec::with_capacity(N);"},{"DocComment":" (0..N).for_each(|_| {"},{"DocComment":"     let data_mutex_clone = Arc::clone(&data_mutex);"},{"DocComment":"     let res_mutex_clone = Arc::clone(&res_mutex);"},{"DocComment":""},{"DocComment":"     threads.push(thread::spawn(move || {"},{"DocComment":"         // Here we use a block to limit the lifetime of the lock guard."},{"DocComment":"         let result = {"},{"DocComment":"             let mut data = data_mutex_clone.lock().unwrap();"},{"DocComment":"             // This is the result of some important and long-ish work."},{"DocComment":"             let result = data.iter().fold(0, |acc, x| acc + x * 2);"},{"DocComment":"             data.push(result);"},{"DocComment":"             result"},{"DocComment":"             // The mutex guard gets dropped here, together with any other values"},{"DocComment":"             // created in the critical section."},{"DocComment":"         };"},{"DocComment":"         // The guard created here is a temporary dropped at the end of the statement, i.e."},{"DocComment":"         // the lock would not remain being held even if the thread did some additional work."},{"DocComment":"         *res_mutex_clone.lock().unwrap() += result;"},{"DocComment":"     }));"},{"DocComment":" });"},{"DocComment":""},{"DocComment":" let mut data = data_mutex.lock().unwrap();"},{"DocComment":" // This is the result of some important and long-ish work."},{"DocComment":" let result = data.iter().fold(0, |acc, x| acc + x * 2);"},{"DocComment":" data.push(result);"},{"DocComment":" // We drop the `data` explicitly because it's not necessary anymore and the"},{"DocComment":" // thread still has work to do. This allows other threads to start working on"},{"DocComment":" // the data immediately, without waiting for the rest of the unrelated work"},{"DocComment":" // to be done here."},{"DocComment":" //"},{"DocComment":" // It's even more important here than in the threads because we `.join` the"},{"DocComment":" // threads after that. If we had not dropped the mutex guard, a thread could"},{"DocComment":" // be waiting forever for it, causing a deadlock."},{"DocComment":" // As in the threads, a block could have been used instead of calling the"},{"DocComment":" // `drop` function."},{"DocComment":" drop(data);"},{"DocComment":" // Here the mutex guard is not assigned to a variable and so, even if the"},{"DocComment":" // scope does not end after this line, the mutex is still released: there is"},{"DocComment":" // no deadlock."},{"DocComment":" *res_mutex.lock().unwrap() += result;"},{"DocComment":""},{"DocComment":" threads.into_iter().for_each(|thread| {"},{"DocComment":"     thread"},{"DocComment":"         .join()"},{"DocComment":"         .expect(\"The thread creating or execution failed !\")"},{"DocComment":" });"},{"DocComment":""},{"DocComment":" assert_eq!(*res_mutex.lock().unwrap(), 800);"},{"DocComment":" ```"},{"DocComment":""}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Mutex"},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":84,"item_meta":{"name":[{"Ident":["std",0]},{"Ident":["sync",0]},{"Ident":["poison",0]},{"Ident":["condvar",0]},{"Ident":["Condvar",0]}],"span":{"Untagged":{"data":{"file_id":81,"beg":{"line":45,"col":0},"end":{"line":45,"col":18}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A Condition Variable"},{"DocComment":""},{"DocComment":" Condition variables represent the ability to block a thread such that it"},{"DocComment":" consumes no CPU time while waiting for an event to occur. Condition"},{"DocComment":" variables are typically associated with a boolean predicate (a condition)"},{"DocComment":" and a mutex. The predicate is always verified inside of the mutex before"},{"DocComment":" determining that a thread must block."},{"DocComment":""},{"DocComment":" Functions in this module will block the current **thread** of execution."},{"DocComment":" Note that any attempt to use multiple mutexes on the same condition"},{"DocComment":" variable may result in a runtime panic."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::{Arc, Mutex, Condvar};"},{"DocComment":" use std::thread;"},{"DocComment":""},{"DocComment":" let pair = Arc::new((Mutex::new(false), Condvar::new()));"},{"DocComment":" let pair2 = Arc::clone(&pair);"},{"DocComment":""},{"DocComment":" // Inside of our lock, spawn a new thread, and then wait for it to start."},{"DocComment":" thread::spawn(move || {"},{"DocComment":"     let (lock, cvar) = &*pair2;"},{"DocComment":"     let mut started = lock.lock().unwrap();"},{"DocComment":"     *started = true;"},{"DocComment":"     // We notify the condvar that the value has changed."},{"DocComment":"     cvar.notify_one();"},{"DocComment":" });"},{"DocComment":""},{"DocComment":" // Wait for the thread to start up."},{"DocComment":" let (lock, cvar) = &*pair;"},{"DocComment":" let mut started = lock.lock().unwrap();"},{"DocComment":" while !*started {"},{"DocComment":"     started = cvar.wait(started).unwrap();"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"aarch64-apple-darwin","value":{"size":{"guarantee":null,"chosen":16},"align":{"guarantee":null,"chosen":8},"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0}],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"}],"fun_decls":[{"def_id":0,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":0}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":1},"kind":"InherentImplBlock"}}},{"Ident":["as_slice",0]}],"span":{"Untagged":{"data":{"file_id":1,"beg":{"line":668,"col":4},"end":{"line":668,"