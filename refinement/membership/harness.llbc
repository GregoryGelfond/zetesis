e":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":5},{"Value":[63,{"RawPtr":[{"Deduplicated":19},"Mut"]}]}],"output":{"Value":[64,{"RawPtr":[{"Deduplicated":20},"Mut"]}]}},"default":null},"kind":{"TraitMethod":[2,3]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"index","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Ident":["SliceIndex",0]},{"Ident":["index",0]}],"span":{"Untagged":{"data":{"file_id":3,"beg":{"line":167,"col":4},"end":{"line":167,"col":47}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns a shared reference to the output at this location, panicking"},{"DocComment":" if out of bounds."},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":3,"beg":{"line":166,"col":4},"end":{"line":166,"col":19}},"generated_from_span":null}}}}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":5},{"Deduplicated":56}],"output":{"Deduplicated":55}},"default":null},"kind":{"TraitMethod":[2,4]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"index_mut","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Ident":["SliceIndex",0]},{"Ident":["index_mut",0]}],"span":{"Untagged":{"data":{"file_id":3,"beg":{"line":173,"col":4},"end":{"line":173,"col":59}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns a mutable reference to the output at this location, panicking"},{"DocComment":" if out of bounds."},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":3,"beg":{"line":172,"col":4},"end":{"line":172,"col":19}},"generated_from_span":null}}}}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":5},{"Deduplicated":58}],"output":{"Deduplicated":60}},"default":null},"kind":{"TraitMethod":[2,5]}}],"vtable":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":19},{"Deduplicated":20}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":3,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["index",0]},{"Ident":["IndexMut",0]}],"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":170,"col":0},"end":{"line":170,"col":57}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used for indexing operations (`container[index]`) in mutable contexts."},{"DocComment":""},{"DocComment":" `container[index]` is actually syntactic sugar for"},{"DocComment":" `*container.index_mut(index)`, but only when used as a mutable value. If"},{"DocComment":" an immutable value is requested, the [`Index`] trait is used instead. This"},{"DocComment":" allows nice things such as `v[index] = value`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" A very simple implementation of a `Balance` struct that has two sides, where"},{"DocComment":" each can be indexed mutably and immutably."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::{Index, IndexMut};"},{"DocComment":""},{"DocComment":" #[derive(Debug)]"},{"DocComment":" enum Side {"},{"DocComment":"     Left,"},{"DocComment":"     Right,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" #[derive(Debug, PartialEq)]"},{"DocComment":" enum Weight {"},{"DocComment":"     Kilogram(f32),"},{"DocComment":"     Pound(f32),"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" struct Balance {"},{"DocComment":"     pub left: Weight,"},{"DocComment":"     pub right: Weight,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Index<Side> for Balance {"},{"DocComment":"     type Output = Weight;"},{"DocComment":""},{"DocComment":"     fn index(&self, index: Side) -> &Self::Output {"},{"DocComment":"         println!(\"Accessing {index:?}-side of balance immutably\");"},{"DocComment":"         match index {"},{"DocComment":"             Side::Left => &self.left,"},{"DocComment":"             Side::Right => &self.right,"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl IndexMut<Side> for Balance {"},{"DocComment":"     fn index_mut(&mut self, index: Side) -> &mut Self::Output {"},{"DocComment":"         println!(\"Accessing {index:?}-side of balance mutably\");"},{"DocComment":"         match index {"},{"DocComment":"             Side::Left => &mut self.left,"},{"DocComment":"             Side::Right => &mut self.right,"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut balance = Balance {"},{"DocComment":"     right: Weight::Kilogram(2.5),"},{"DocComment":"     left: Weight::Pound(1.5),"},{"DocComment":" };"},{"DocComment":""},{"DocComment":" // In this case, `balance[Side::Right]` is sugar for"},{"DocComment":" // `*balance.index(Side::Right)`, since we are only *reading*"},{"DocComment":" // `balance[Side::Right]`, not writing it."},{"DocComment":" assert_eq!(balance[Side::Right], Weight::Kilogram(2.5));"},{"DocComment":""},{"DocComment":" // However, in this case `balance[Side::Left]` is sugar for"},{"DocComment":" // `*balance.index_mut(Side::Left)`, since we are writing"},{"DocComment":" // `balance[Side::Left]`."},{"DocComment":" balance[Side::Left] = Weight::Kilogram(3.0);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"IndexMut","diagnostic_item":null},"src":"Normal","generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Idx","variance":"Unknown"},{"index":2,"name":"Self_Clause0_Output","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[52,{"data":{"file_id":6,"beg":{"line":170,"col":39},"end":{"line":170,"col":57}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":5},{"Deduplicated":19},{"Deduplicated":20}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"index_mut","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["index",0]},{"Ident":["IndexMut",0]},{"Ident":["index_mut",0]}],"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":179,"col":4},"end":{"line":179,"col":61}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Performs the mutable indexing (`container[index]`) operation."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" May panic if the index is out of bounds."},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":6,"beg":{"line":178,"col":4},"end":{"line":178,"col":19}},"generated_from_span":null}}}}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[65,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":5},"Mut"]}]},{"Deduplicated":19}],"output":{"Deduplicated":60}},"default":null},"kind":{"TraitMethod":[3,0]}}],"vtable":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":19},{"Deduplicated":20}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":4,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Destruct",0]}],"span":{"Untagged":{"data":{"file_id":11,"beg":{"line":1063,"col":0},"end":{"line":1063,"col":38}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A marker for types that can be dropped."},{"DocComment":""},{"DocComment":" This should be used for `[const]` bounds,"},{"DocComment":" as non-const bounds will always hold for every type."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"Destruct","diagnostic_item":null},"src":"Normal","generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"drop_glue","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Destruct",0]},{"Ident":["drop_glue",0]}],"span":{"Untagged":{"data":{"file_id":11,"beg":{"line":1063,"col":0},"end":{"line":1063,"col":38}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":65}],"output":{"Deduplicated":30}},"default":null},"kind":{"TraitMethod":[4,0]}}],"vtable":null},{"def_id":5,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["deref",0]},{"Ident":["Deref",0]}],"span":{"Untagged":{"data":{"file_id":17,"beg":{"line":139,"col":0},"end":{"line":139,"col":35}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used for immutable dereferencing operations, like `*v`."},{"DocComment":""},{"DocComment":" In addition to being used for explicit dereferencing operations with the"},{"DocComment":" (unary) `*` operator in immutable contexts, `Deref` is also used implicitly"},{"DocComment":" by the compiler in many circumstances. This mechanism is called"},{"DocComment":" [\"`Deref` coercion\"][coercion]. In mutable contexts, [`DerefMut`] is used and"},{"DocComment":" mutable deref coercion similarly occurs."},{"DocComment":""},{"DocComment":" **Warning:** Deref coercion is a powerful language feature which has"},{"DocComment":" far-reaching implications for every type that implements `Deref`. The"},{"DocComment":" compiler will silently insert calls to `Deref::deref`. For this reason, one"},{"DocComment":" should be careful about implementing `Deref` and only do so when deref"},{"DocComment":" coercion is desirable. See [below][implementing] for advice on when this is"},{"DocComment":" typically desirable or undesirable."},{"DocComment":""},{"DocComment":" Types that implement `Deref` or `DerefMut` are often called \"smart"},{"DocComment":" pointers\" and the mechanism of deref coercion has been specifically designed"},{"DocComment":" to facilitate the pointer-like behavior that name suggests. Often, the"},{"DocComment":" purpose of a \"smart pointer\" type is to change the ownership semantics"},{"DocComment":" of a contained value (for example, [`Rc`][rc] or [`Cow`][cow]) or the"},{"DocComment":" storage semantics of a contained value (for example, [`Box`][box])."},{"DocComment":""},{"DocComment":" # Deref coercion"},{"DocComment":""},{"DocComment":" If `T` implements `Deref<Target = U>`, and `v` is a value of type `T`, then:"},{"DocComment":""},{"DocComment":" * In immutable contexts, `*v` (where `T` is neither a reference nor a raw"},{"DocComment":"   pointer) is equivalent to `*Deref::deref(&v)`."},{"DocComment":" * Values of type `&T` are coerced to values of type `&U`"},{"DocComment":" * `T` implicitly implements all the methods of the type `U` which take the"},{"DocComment":"   `&self` receiver."},{"DocComment":""},{"DocComment":" For more details, visit [the chapter in *The Rust Programming Language*][book]"},{"DocComment":" as well as the reference sections on [the dereference operator][ref-deref-op],"},{"DocComment":" [method resolution], and [type coercions]."},{"DocComment":""},{"DocComment":" # When to implement `Deref` or `DerefMut`"},{"DocComment":""},{"DocComment":" The same advice applies to both deref traits. In general, deref traits"},{"DocComment":" **should** be implemented if:"},{"DocComment":""},{"DocComment":" 1. a value of the type transparently behaves like a value of the target"},{"DocComment":"    type;"},{"DocComment":" 1. the implementation of the deref function is cheap; and"},{"DocComment":" 1. users of the type will not be surprised by any deref coercion behavior."},{"DocComment":""},{"DocComment":" In general, deref traits **should not** be implemented if:"},{"DocComment":""},{"DocComment":" 1. the deref implementations could fail unexpectedly; or"},{"DocComment":" 1. the type has methods that are likely to collide with methods on the"},{"DocComment":"    target type; or"},{"DocComment":" 1. committing to deref coercion as part of the public API is not desirable."},{"DocComment":""},{"DocComment":" Note that there's a large difference between implementing deref traits"},{"DocComment":" generically over many target types, and doing so only for specific target"},{"DocComment":" types."},{"DocComment":""},{"DocComment":" Generic implementations, such as for [`Box<T>`][box] (which is generic over"},{"DocComment":" every type and dereferences to `T`) should be careful to provide few or no"},{"DocComment":" methods, since the target type is unknown and therefore every method could"},{"DocComment":" collide with one on the target type, causing confusion for users."},{"DocComment":" `impl<T> Box<T>` has no methods (though several associated functions),"},{"DocComment":" partly for this reason."},{"DocComment":""},{"DocComment":" Specific implementations, such as for [`String`][string] (whose `Deref`"},{"DocComment":" implementation has `Target = str`) can have many methods, since avoiding"},{"DocComment":" collision is much easier. `String` and `str` both have many methods, and"},{"DocComment":" `String` additionally behaves as if it has every method of `str` because of"},{"DocComment":" deref coercion. The implementing type may also be generic while the"},{"DocComment":" implementation is still specific in this sense; for example, [`Vec<T>`][vec]"},{"DocComment":" dereferences to `[T]`, so methods of `T` are not applicable."},{"DocComment":""},{"DocComment":" Consider also that deref coercion means that deref traits are a much larger"},{"DocComment":" part of a type's public API than any other trait as it is implicitly called"},{"DocComment":" by the compiler. Therefore, it is advisable to consider whether this is"},{"DocComment":" something you are comfortable supporting as a public API."},{"DocComment":""},{"DocComment":" The [`AsRef`] and [`Borrow`][core::borrow::Borrow] traits have very similar"},{"DocComment":" signatures to `Deref`. It may be desirable to implement either or both of"},{"DocComment":" these, whether in addition to or rather than deref traits. See their"},{"DocComment":" documentation for details."},{"DocComment":""},{"DocComment":" # Fallibility"},{"DocComment":""},{"DocComment":" **This trait's method should never unexpectedly fail**. Deref coercion means"},{"DocComment":" the compiler will often insert calls to `Deref::deref` implicitly. Failure"},{"DocComment":" during dereferencing can be extremely confusing when `Deref` is invoked"},{"DocComment":" implicitly. In the majority of uses it should be infallible, though it may"},{"DocComment":" be acceptable to panic if the type is misused through programmer error, for"},{"DocComment":" example."},{"DocComment":""},{"DocComment":" However, infallibility is not enforced and therefore not guaranteed."},{"DocComment":" As such, `unsafe` code should not rely on infallibility in general for"},{"DocComment":" soundness."},{"DocComment":""},{"DocComment":" [book]: ../../book/ch15-02-deref.html"},{"DocComment":" [coercion]: #deref-coercion"},{"DocComment":" [implementing]: #when-to-implement-deref-or-derefmut"},{"DocComment":" [ref-deref-op]: ../../reference/expressions/operator-expr.html#the-dereference-operator"},{"DocComment":" [method resolution]: ../../reference/expressions/method-call-expr.html"},{"DocComment":" [type coercions]: ../../reference/type-coercions.html"},{"DocComment":" [box]: ../../alloc/boxed/struct.Box.html"},{"DocComment":" [string]: ../../alloc/string/struct.String.html"},{"DocComment":" [vec]: ../../alloc/vec/struct.Vec.html"},{"DocComment":" [rc]: ../../alloc/rc/struct.Rc.html"},{"DocComment":" [cow]: ../../alloc/borrow/enum.Cow.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" A struct with a single field which is accessible by dereferencing the"},{"DocComment":" struct."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::Deref;"},{"DocComment":""},{"DocComment":" struct DerefExample<T> {"},{"DocComment":"     value: T"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<T> Deref for DerefExample<T> {"},{"DocComment":"     type Target = T;"},{"DocComment":""},{"DocComment":"     fn deref(&self) -> &Self::Target {"},{"DocComment":"         &self.value"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let x = DerefExample { value: 'a' };"},{"DocComment":" assert_eq!('a', *x);"},{"DocComment":" ```"}],"inline":null